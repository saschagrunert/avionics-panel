# What pytest --cov measures (build.sh; CI sends the result to Codecov): the files that go on the board. The
# tests themselves are left out, and so are make_buttons.py and make_keys.py, which stay on the PC: build.sh runs
# them, and CI checks the BUTTONS.md and KEYS.md they write.
[run]
source = firmware
omit =
    firmware/test_*.py
    firmware/make_*.py
