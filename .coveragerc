# What pytest --cov measures (build.sh; CI sends the result to Codecov): the files that go on the board, by line
# and by branch. The tests themselves are left out, and so are make_buttons.py and make_keys.py, which stay on the
# PC: build.sh runs them, and CI checks the BUTTONS.md and KEYS.md they write. A run that leaves a line or a
# branch of those files untested fails.
[run]
source = firmware
branch = True
omit =
    firmware/test_*.py
    firmware/make_*.py

[report]
fail_under = 100
